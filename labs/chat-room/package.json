{
	"name": "@cinder/chat-room-lab",
	"version": "0.0.5",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:client-styles": "bun scripts/check-client-styles.ts",
		"check:upstream": "bun scripts/check-upstream-issues.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"test": "bun run test:unit",
		"test:live-operative": "bun scripts/test-live-operative.ts",
		"test:playwright": "playwright install && playwright test",
		"test:unit": "bun test ./scripts/check-client-styles.test.ts ./scripts/check-upstream-issues.test.ts ./scripts/playwright-collision-guard.test.ts ./scripts/test-unit-runs-every-unit-test.test.ts ./src/routes/api/chat/chat-server.test.ts ./src/lib/toolbox-ownership.test.ts ./src/lib/operative-is-the-only-engine.test.ts ./src/lib/server-owned-runtime.test.ts ./src/lib/server-owned-conversations.test.ts ./src/lib/server-owned-durable.test.ts ./src/lib/chat-agent.test.ts ./scripts/script-imports.test.ts ./src/lib/chat-run-response-wiring.test.ts ./src/lib/server-owned-unavailable.test.ts ./src/lib/server-owned-recovery.test.ts ./src/lib/server-owned-recovery-contract.test.ts ./src/lib/server-owned-storage.test.ts ./src/lib/server-owned-elicitation.test.ts",
		"test:unit-inventory": "bun test ./scripts/test-unit-runs-every-unit-test.test.ts",
		"validate": "bun run lint && bun run check && bun run test:unit && bun run test:unit-inventory && bun run build && bun run check:client-styles"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.116.0",
		"@lasercat/homogenaize": "^1.2.41",
		"@lostgradient/chat": "workspace:*",
		"@lostgradient/cinder": "workspace:*",
		"@lostgradient/editor": "workspace:*",
		"@lostgradient/markdown": "workspace:*",
		"@lostgradient/operative": "0.11.0",
		"@lostgradient/weft": "^0.23.1",
		"@milkdown/ctx": "^7.17.3",
		"@milkdown/kit": "^7.17.3",
		"@milkdown/prose": "^7.17.3",
		"armorer": "^2.1.0",
		"conversationalist": "^1.1.0",
		"lucide-svelte": "0.577.0",
		"prosemirror-inputrules": "^1.5.1",
		"prosemirror-model": "^1.25.4",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lostgradient/cinder-mcp": "workspace:*",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	}
}
