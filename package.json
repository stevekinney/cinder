{
  "name": "cinder-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "applications/*",
    "components/*",
    "packages/*",
    "internal/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=@lostgradient/cinder --filter=@lostgradient/cinder-mcp --filter=@lostgradient/editor --filter=@lostgradient/chat",
    "changeset": "changeset",
    "changeset:publish": "bun run --filter=@lostgradient/markdown publish:release && bun run --filter=@lostgradient/cinder publish:release && bun run --filter=@lostgradient/editor publish:release && bun run --filter=@lostgradient/chat publish:release && bun run --filter=@lostgradient/cinder-mcp publish:release",
    "changeset:publish:dry": "bun run --filter=@lostgradient/markdown validate:consumer && bun run --filter=@lostgradient/cinder validate:consumer && bun run --filter=@lostgradient/editor validate:consumer && bun run --filter=@lostgradient/chat validate:consumer && bun run --filter=@lostgradient/cinder-mcp validate:consumer && bun run --filter=@lostgradient/markdown publish:release -- --dry-run --skip-validation && bun run --filter=@lostgradient/cinder publish:release -- --dry-run --skip-validation && bun run --filter=@lostgradient/editor publish:release -- --dry-run --skip-validation && bun run --filter=@lostgradient/chat publish:release -- --dry-run --skip-validation && bun run --filter=@lostgradient/cinder-mcp publish:release -- --dry-run --skip-validation",
    "changeset:version": "bun run packages/components/scripts/prepare-internal-peer-changesets.ts && changeset version && bun run packages/components/scripts/reconcile-internal-peers.ts && bun run --filter=@lostgradient/cinder components:generate && bun run --filter=@lostgradient/editor components:generate && bun run --filter=@lostgradient/chat components:generate && bun install --lockfile-only && bun install --frozen-lockfile",
    "clean": "bun run --filter='*' clean",
    "dev": "bun run --filter='@cinder/playground' dev",
    "playground": "bun run --filter='@cinder/playground' dev",
    "typecheck": "turbo run typecheck --concurrency=1",
    "validate:consumer": "bun run --filter=@lostgradient/markdown validate:consumer && bun run --filter=@lostgradient/cinder validate:consumer && bun run --filter=@lostgradient/editor validate:consumer && bun run --filter=@lostgradient/chat validate:consumer && bun run --filter=@lostgradient/cinder-mcp validate:consumer"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@types/bun": "1.3.14",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.0",
    "sort-package-json": "^3.6.1",
    "stylelint": "^17.11.1",
    "stylelint-use-logical": "^2.1.3",
    "turbo": "2.10.5"
  },
  "packageManager": "bun@1.4.2",
