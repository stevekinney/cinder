{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bun run vercel-build",
  "installCommand": "cd ../.. && NODE_ENV=development bun install --frozen-lockfile",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/c/:name",
      "destination": "/page/:name",
      "statusCode": 301
    }
  ]
}
