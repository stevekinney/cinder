{
  "name": "@cinder/testing",
  "private": true,
  "type": "module",
  "scripts": {
    "contact-sheets": "bun run scripts/generate-contact-sheets.ts",
    "install-browsers": "playwright install chromium",
    "install-browsers:ci": "playwright install --with-deps chromium",
    "kill:playground": "bun run scripts/kill-playground.ts",
    "report": "playwright show-report ./playwright-report",
    "test": "bun run typecheck && bun test",
    "test:browser:docker": "bun run scripts/run-browser-docker.ts",
    "test:browser:update": "bun run scripts/update-snapshots.ts",
    "test:browser:update:docker": "bun run scripts/update-snapshots-docker.ts",
    "test:playwright": "bun run scripts/start-server.ts",
    "test:playwright:headed": "bun run scripts/start-server.ts -- --headed",
    "test:playwright:ui": "bun run scripts/start-server.ts -- --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lostgradient/environmentalist": "0.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.10.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "postcss-value-parser": "^4.2.0",
    "typescript": "6.0.3"
  }
}
