{
  "$schema": "../../schemas/examples.schema.json",
  "component": "pricing-card",
  "import": "@lostgradient/cinder/pricing-card",
  "examples": [
    {
      "id": "pricing-section",
      "title": "Pricing section",
      "description": "A full pricing-section recipe: Container frames a heading and supporting copy above a responsive grid of PricingCard plans with selection.",
      "code": "<script lang=\"ts\">\n  import { Container } from '@lostgradient/cinder/container';\n  import { PricingCard } from '@lostgradient/cinder/pricing-card';\n\n  const plans = [\n    {\n      name: 'Starter',\n      price: '$0',\n      features: ['3 projects', 'Community support'],\n      callToActionLabel: 'Start free',\n    },\n    {\n      name: 'Pro',\n      price: '$49 / month',\n      features: ['Unlimited projects', 'Priority support', 'Team roles'],\n      callToActionLabel: 'Choose Pro',\n    },\n    {\n      name: 'Enterprise',\n      price: 'Contact us',\n      features: ['SSO + SCIM', 'Audit logs', 'Dedicated support'],\n      callToActionLabel: 'Talk to sales',\n    },\n  ];\n\n  let selectedPlan = $state('Pro');\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div style=\"display: grid; gap: var(--cinder-space-6);\">\n      <header style=\"display: grid; gap: var(--cinder-space-2); max-inline-size: 60ch;\">\n        <h2 style=\"margin: 0;\">Pricing for teams of every size</h2>\n        <p style=\"margin: 0; color: var(--cinder-text-muted);\">\n          Start free, then scale with advanced collaboration and enterprise controls.\n        </p>\n      </header>\n\n      <ul\n        style=\"list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--cinder-space-4); align-items: start;\"\n      >\n        {#each plans as plan (plan.name)}\n          <li>\n            <PricingCard\n              name={plan.name}\n              price={plan.price}\n              features={plan.features}\n              callToActionLabel={plan.callToActionLabel}\n              selected={selectedPlan === plan.name}\n              onPlanSelect={() => {\n                selectedPlan = plan.name;\n              }}\n            />\n          </li>\n        {/each}\n      </ul>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "tiers",
      "title": "Pricing tiers",
      "description": "Three plan tiles side by side with one pre-selected.",
      "code": "<script lang=\"ts\">\n  import { PricingCard } from '@lostgradient/cinder/pricing-card';\n\n  let selectedPlan = $state<'starter' | 'pro' | 'enterprise'>('pro');\n</script>\n\n<div\n  style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--cinder-space-4); align-items: start;\"\n>\n  <PricingCard\n    name=\"Starter\"\n    price=\"Free\"\n    features={['3 projects', '1 GB storage', 'Community support']}\n    callToActionLabel=\"Get started\"\n    selected={selectedPlan === 'starter'}\n    onPlanSelect={() => {\n      selectedPlan = 'starter';\n    }}\n  />\n\n  <PricingCard\n    name=\"Pro\"\n    price=\"$9/mo\"\n    features={['Unlimited projects', '10 GB storage', 'Priority support', 'Custom domains']}\n    callToActionLabel=\"Choose Pro\"\n    selected={selectedPlan === 'pro'}\n    onPlanSelect={() => {\n      selectedPlan = 'pro';\n    }}\n  />\n\n  <PricingCard\n    name=\"Enterprise\"\n    price=\"$49/mo\"\n    features={[\n      'Unlimited projects',\n      '500 GB storage',\n      'Dedicated support',\n      'Custom domains',\n      'SSO & audit logs',\n    ]}\n    callToActionLabel=\"Contact sales\"\n    selected={selectedPlan === 'enterprise'}\n    onPlanSelect={() => {\n      selectedPlan = 'enterprise';\n    }}\n  />\n</div>\n"
    },
    {
      "id": "with-caveat",
      "title": "With caveat",
      "description": "A pricing card with a consumer-supplied caveat beneath the feature list, useful for legal disclaimers or billing notes.",
      "code": "<script lang=\"ts\">\n  import { PricingCard } from '@lostgradient/cinder/pricing-card';\n</script>\n\n<div style=\"max-inline-size: 22rem;\">\n  <PricingCard\n    name=\"Growth\"\n    price=\"$29/mo\"\n    features={['Unlimited projects', '50 GB storage', 'Email & chat support', 'Advanced analytics']}\n    caveat=\"Billed annually. Monthly billing available at $35/mo.\"\n    callToActionLabel=\"Start free trial\"\n    onPlanSelect={() => {}}\n  />\n</div>\n"
    },
    {
      "id": "with-href",
      "title": "Linking to checkout",
      "description": "When the CTA should navigate rather than run in-page logic, pass href (and optionally target/rel) and the CTA renders as an anchor. onPlanSelect is still called if provided, useful for analytics.",
      "code": "<script lang=\"ts\">\n  import { PricingCard } from '@lostgradient/cinder/pricing-card';\n</script>\n\n<div style=\"max-inline-size: 22rem;\">\n  <PricingCard\n    name=\"Pro\"\n    price=\"$29/mo\"\n    features={['Unlimited projects', '50 GB storage', 'Priority support']}\n    callToActionLabel=\"Continue to checkout\"\n    href=\"/checkout?plan=pro\"\n    target=\"_blank\"\n    rel=\"noopener noreferrer\"\n    onPlanSelect={() => {\n      // e.g. track an analytics event before navigation\n    }}\n  />\n</div>\n"
    }
  ]
}
