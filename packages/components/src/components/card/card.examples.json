{
  "$schema": "../../schemas/examples.schema.json",
  "component": "card",
  "import": "@lostgradient/cinder/card",
  "examples": [
    {
      "id": "basic",
      "title": "Basic card",
      "description": "A plain bordered card with a single body region.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card>\n  <div\n    style=\"min-block-size: 8rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n</Card>\n"
    },
    {
      "id": "blog-post-grid",
      "title": "Blog post grid",
      "description": "An article-listing section recipe: Cards carry post image, category metadata, linked title, excerpt, and an Avatar author byline.",
      "code": "<script lang=\"ts\">\n  import { Avatar } from '@lostgradient/cinder/avatar';\n  import { Card } from '@lostgradient/cinder/card';\n  import { Container } from '@lostgradient/cinder/container';\n\n  const posts = [\n    {\n      title: 'How we scaled our design system governance',\n      excerpt: 'A practical playbook for cross-team contributions and review workflows.',\n      href: '#',\n      category: 'Engineering',\n      publishedAt: 'Jun 20, 2026',\n      authorName: 'Morgan Yu',\n      authorRole: 'Staff Engineer',\n    },\n    {\n      title: 'Product launch checklist for frontend teams',\n      excerpt: 'A repeatable checklist that reduces launch-day surprises.',\n      href: '#',\n      category: 'Product',\n      publishedAt: 'Jun 8, 2026',\n      authorName: 'Jamie Patel',\n      authorRole: 'Product Manager',\n    },\n    {\n      title: 'Accessibility debt: how to find and fix it early',\n      excerpt: 'Methods for integrating inclusive QA before code reaches production.',\n      href: '#',\n      category: 'Accessibility',\n      publishedAt: 'May 27, 2026',\n      authorName: 'Casey Murray',\n      authorRole: 'Design Systems Lead',\n    },\n  ];\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div style=\"display: grid; gap: var(--cinder-space-6);\">\n      <header style=\"display: grid; gap: var(--cinder-space-2); max-inline-size: 60ch;\">\n        <h2 style=\"margin: 0;\">Latest from the Cinder blog</h2>\n        <p style=\"margin: 0; color: var(--cinder-text-muted);\">\n          Guides, launch lessons, and design-system practices from our product team.\n        </p>\n      </header>\n\n      <ul\n        style=\"list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--cinder-space-4);\"\n      >\n        {#each posts as post (post.title)}\n          <li>\n            <Card>\n              <article>\n                <!-- Placeholder cover panel — a real app renders the post's cover\n                     <img> here with the same geometry. -->\n                <div\n                  aria-hidden=\"true\"\n                  style=\"inline-size: 100%; aspect-ratio: 16 / 9; background: var(--cinder-surface-inset); border-radius: var(--cinder-radius-md); margin-block-end: var(--cinder-space-3);\"\n                ></div>\n                <p\n                  style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\"\n                >\n                  {post.category} · {post.publishedAt}\n                </p>\n                <h3 style=\"margin: var(--cinder-space-2) 0; font-size: var(--cinder-text-lg);\">\n                  <a\n                    href={post.href}\n                    style=\"color: var(--cinder-text-default); text-decoration: none;\"\n                  >\n                    {post.title}\n                  </a>\n                </h3>\n                <p\n                  style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\"\n                >\n                  {post.excerpt}\n                </p>\n                <div\n                  style=\"margin-block-start: var(--cinder-space-4); display: flex; align-items: center; gap: var(--cinder-space-3);\"\n                >\n                  <Avatar name={post.authorName} size=\"sm\" />\n                  <div style=\"display: grid; gap: var(--cinder-space-1);\">\n                    <p\n                      style=\"margin: 0; font-size: var(--cinder-text-sm); font-weight: var(--cinder-font-semibold); line-height: var(--cinder-leading-snug);\"\n                    >\n                      {post.authorName}\n                    </p>\n                    <p\n                      style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm); line-height: var(--cinder-leading-snug);\"\n                    >\n                      {post.authorRole}\n                    </p>\n                  </div>\n                </div>\n              </article>\n            </Card>\n          </li>\n        {/each}\n      </ul>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "danger-zone-action",
      "title": "Danger zone action",
      "description": "A destructive action inside a danger-tone Card with the confirmation flow delegated to ConfirmDialog.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder/button';\n  import { Card } from '@lostgradient/cinder/card';\n  import { ConfirmDialog } from '@lostgradient/cinder/confirm-dialog';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n  let deleted = $state(false);\n</script>\n\n<Card\n  tone=\"danger\"\n  title=\"Delete project\"\n  description=\"Permanently removes project settings, review history, and saved automation rules.\"\n>\n  <p style=\"margin: 0; color: var(--cinder-text-subtle); font-size: var(--cinder-text-sm);\">\n    {deleted\n      ? 'The deletion flow completed.'\n      : 'Export any data you need before deleting this project.'}\n  </p>\n\n  {#snippet footer()}\n    <Button\n      variant=\"danger\"\n      label=\"Delete project\"\n      disabled={deleted}\n      onclick={(event) => {\n        triggerRef = event.currentTarget as HTMLElement;\n        open = true;\n      }}\n    />\n  {/snippet}\n</Card>\n\n<ConfirmDialog\n  bind:open\n  {triggerRef}\n  title=\"Delete this project?\"\n  description=\"This action is permanent. Project settings, review history, and automation rules cannot be restored.\"\n  destructive\n  confirmLabel=\"Delete project\"\n  onConfirm={() => (deleted = true)}\n  onCancel={() => (open = false)}\n/>\n"
    },
    {
      "id": "danger-zone-toggle",
      "title": "Danger zone setting",
      "description": "A high-risk settings card with container-level danger treatment, a switch, and a confirmation dialog before the risky state is applied.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder/button';\n  import { Card } from '@lostgradient/cinder/card';\n  import { ConfirmDialog } from '@lostgradient/cinder/confirm-dialog';\n  import { Toggle } from '@lostgradient/cinder/toggle';\n\n  let paused = $state(false);\n  let confirmOpen = $state(false);\n\n  function requestPause(next: boolean): boolean {\n    if (!next) return false;\n    confirmOpen = true;\n    return paused;\n  }\n</script>\n\n<Card\n  tone=\"danger\"\n  title=\"Pause reviews\"\n  description=\"Stops new review dispatch globally. Existing in-flight reviews can finish, but no new work will be assigned until reviews are resumed.\"\n>\n  <div style=\"display: grid; gap: var(--cinder-space-3);\">\n    <Toggle\n      id=\"pause-reviews\"\n      bind:checked={paused}\n      label=\"Reviews paused\"\n      onValueChangeRequest={requestPause}\n    />\n    <p style=\"margin: 0; color: var(--cinder-text-subtle); font-size: var(--cinder-text-sm);\">\n      Current state: <strong>{paused ? 'Paused' : 'Dispatching reviews'}</strong>\n    </p>\n  </div>\n\n  {#snippet footer()}\n    {#if paused}\n      <Button variant=\"secondary\" label=\"Resume reviews\" onclick={() => (paused = false)} />\n    {/if}\n  {/snippet}\n</Card>\n\n<ConfirmDialog\n  bind:open={confirmOpen}\n  title=\"Pause review dispatch?\"\n  description=\"This affects every repository connected to the workspace. New reviews will stop until an administrator resumes dispatch.\"\n  destructive\n  confirmLabel=\"Pause reviews\"\n  onConfirm={() => (paused = true)}\n  onCancel={() => (confirmOpen = false)}\n/>\n"
    },
    {
      "id": "edge-to-edge-mobile",
      "title": "Card, edge-to-edge on mobile",
      "description": "A card that bleeds to the viewport edge below the mobile breakpoint.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card edgeToEdgeOnMobile>\n  <div\n    style=\"min-block-size: 8rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n</Card>\n"
    },
    {
      "id": "flush-body",
      "title": "Flush body (padding=\"none\")",
      "description": "Pass padding=\"none\" to remove the body padding for full-bleed content such as an image or a data table.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card title=\"Full-bleed image card\" padding=\"none\">\n  <div\n    style=\"min-block-size: 8rem; background: var(--cinder-surface-inset); border-top: 1px solid var(--cinder-border-muted); display: flex; align-items: center; justify-content: center; color: var(--cinder-text-subtle); font-size: var(--cinder-text-sm);\"\n  >\n    full-bleed content area\n  </div>\n  {#snippet footer()}\n    Footer actions retain their standard inset.\n  {/snippet}\n</Card>\n"
    },
    {
      "id": "team-roster",
      "title": "Team roster",
      "description": "A meet-the-team section recipe: profile Cards with an Avatar, role, bio, and profile link, plus an AvatarGroup summary row above the grid.",
      "code": "<script lang=\"ts\">\n  import { Avatar } from '@lostgradient/cinder/avatar';\n  import { AvatarGroup } from '@lostgradient/cinder/avatar-group';\n  import { Card } from '@lostgradient/cinder/card';\n  import { Container } from '@lostgradient/cinder/container';\n\n  const members = [\n    {\n      name: 'Jordan Lee',\n      role: 'Engineering Lead',\n      bio: 'Leads our platform architecture and component quality initiatives.',\n      href: '#',\n    },\n    {\n      name: 'Taylor Green',\n      role: 'Product Designer',\n      bio: 'Designs cohesive product experiences across web and mobile.',\n      href: '#',\n    },\n    {\n      name: 'Riley Park',\n      role: 'Developer Advocate',\n      bio: 'Helps teams adopt Cinder with docs, examples, and workshops.',\n      href: '#',\n    },\n  ];\n\n  const avatarItems = members.map((member) => ({ name: member.name }));\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div style=\"display: grid; gap: var(--cinder-space-6);\">\n      <header style=\"display: grid; gap: var(--cinder-space-2); max-inline-size: 60ch;\">\n        <h2 style=\"margin: 0; font-size: var(--cinder-text-3xl);\">Meet the team behind Cinder</h2>\n        <p style=\"margin: 0; color: var(--cinder-text-muted);\">\n          A cross-functional group of engineers, designers, and educators.\n        </p>\n      </header>\n\n      <div>\n        <AvatarGroup avatars={avatarItems} label=\"Team members\" maxVisible={6} />\n      </div>\n\n      <ul\n        style=\"list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--cinder-space-4);\"\n      >\n        {#each members as member (member.name)}\n          <li>\n            <Card>\n              <div style=\"display: flex; align-items: center; gap: var(--cinder-space-3);\">\n                <Avatar name={member.name} size=\"lg\" />\n                <div style=\"display: grid; gap: var(--cinder-space-1);\">\n                  <p\n                    style=\"margin: 0; font-size: var(--cinder-text-sm); font-weight: var(--cinder-font-semibold); line-height: var(--cinder-leading-snug);\"\n                  >\n                    {member.name}\n                  </p>\n                  <p\n                    style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm); line-height: var(--cinder-leading-snug);\"\n                  >\n                    {member.role}\n                  </p>\n                </div>\n              </div>\n              <p\n                style=\"margin: var(--cinder-space-3) 0 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\"\n              >\n                {member.bio}\n              </p>\n              <a\n                href={member.href}\n                aria-label={`View ${member.name}'s profile`}\n                style=\"display: inline-flex; margin-block-start: var(--cinder-space-3); font-size: var(--cinder-text-sm); color: var(--cinder-accent-text); text-decoration: none;\"\n              >\n                View profile\n              </a>\n            </Card>\n          </li>\n        {/each}\n      </ul>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "testimonial-grid",
      "title": "Testimonial grid",
      "description": "A social-proof section recipe: Cards hold customer blockquotes with an Avatar byline attributing each quote to a person and company.",
      "code": "<script lang=\"ts\">\n  import { Avatar } from '@lostgradient/cinder/avatar';\n  import { Card } from '@lostgradient/cinder/card';\n  import { Container } from '@lostgradient/cinder/container';\n\n  const testimonials = [\n    {\n      quote: 'Cinder helped us replace six internal UI kits with one consistent system.',\n      name: 'Priya Singh',\n      role: 'VP Product',\n      company: 'Kiteworks',\n    },\n    {\n      quote: 'Our engineers now focus on business value instead of reinventing controls.',\n      name: 'Marcus Chen',\n      role: 'Engineering Manager',\n      company: 'Northline',\n    },\n    {\n      quote: 'The accessibility defaults saved us weeks of QA cycles.',\n      name: 'Casey Murray',\n      role: 'Staff Designer',\n      company: 'Anchor',\n    },\n  ];\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div style=\"display: grid; gap: var(--cinder-space-6);\">\n      <header style=\"display: grid; gap: var(--cinder-space-2); max-inline-size: 60ch;\">\n        <h2 style=\"margin: 0; font-size: var(--cinder-text-3xl);\">Loved by product teams</h2>\n        <p style=\"margin: 0; color: var(--cinder-text-muted);\">\n          From startups to large orgs, teams use Cinder to deliver consistent interfaces quickly.\n        </p>\n      </header>\n\n      <ul\n        style=\"list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--cinder-space-4);\"\n      >\n        {#each testimonials as item (item.name)}\n          <li>\n            <Card>\n              <blockquote\n                style=\"margin: 0; font-size: var(--cinder-text-lg); line-height: var(--cinder-leading-relaxed);\"\n              >\n                “{item.quote}”\n              </blockquote>\n              <div\n                style=\"margin-block-start: var(--cinder-space-4); display: flex; align-items: center; gap: var(--cinder-space-3);\"\n              >\n                <Avatar name={item.name} size=\"sm\" />\n                <div style=\"display: grid; gap: var(--cinder-space-1);\">\n                  <p\n                    style=\"margin: 0; font-size: var(--cinder-text-sm); font-weight: var(--cinder-font-semibold); line-height: var(--cinder-leading-snug);\"\n                  >\n                    {item.name}\n                  </p>\n                  <p\n                    style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm); line-height: var(--cinder-leading-snug);\"\n                  >\n                    {item.role} · {item.company}\n                  </p>\n                </div>\n              </div>\n            </Card>\n          </li>\n        {/each}\n      </ul>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "well-edge-to-edge-mobile",
      "title": "Well, edge-to-edge on mobile",
      "description": "A well that bleeds to the viewport edge below the mobile breakpoint.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card variant=\"well\" edgeToEdgeOnMobile>\n  <div\n    style=\"min-block-size: 8rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n</Card>\n"
    },
    {
      "id": "well-on-gray",
      "title": "Well on grey",
      "description": "A well presented on a muted surrounding surface.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<div\n  style=\"padding: var(--cinder-space-4); border-radius: var(--cinder-radius-lg); background: var(--cinder-surface-inset);\"\n>\n  <Card variant=\"well\">\n    <div\n      style=\"min-block-size: 8rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n    ></div>\n  </Card>\n</div>\n"
    },
    {
      "id": "well",
      "title": "Well",
      "description": "A flatter inset container for low-emphasis grouped content.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card variant=\"well\">\n  <div\n    style=\"min-block-size: 8rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n</Card>\n"
    },
    {
      "id": "with-footer",
      "title": "Card with footer",
      "description": "A card with a separated footer region below the body.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card>\n  <div\n    style=\"inline-size: 100%; min-block-size: 7rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n  {#snippet footer()}\n    <div\n      style=\"inline-size: 100%; min-block-size: 1.5rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n    ></div>\n  {/snippet}\n</Card>\n"
    },
    {
      "id": "with-gray-body",
      "title": "Card with grey body",
      "description": "A card whose body uses the muted surface tone.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card bodyTone=\"muted\">\n  {#snippet header()}\n    <div\n      style=\"inline-size: 100%; min-block-size: 1.5rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n    ></div>\n  {/snippet}\n  <div\n    style=\"inline-size: 100%; min-block-size: 7rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n</Card>\n"
    },
    {
      "id": "with-gray-footer",
      "title": "Card with grey footer",
      "description": "A card whose footer uses the muted surface tone.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card footerTone=\"muted\">\n  <div\n    style=\"inline-size: 100%; min-block-size: 7rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n  {#snippet footer()}\n    <div\n      style=\"inline-size: 100%; min-block-size: 1.5rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n    ></div>\n  {/snippet}\n</Card>\n"
    },
    {
      "id": "with-header-and-footer",
      "title": "Card with header and footer",
      "description": "A card with separated header, body, and footer regions.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card>\n  {#snippet header()}\n    <div\n      style=\"inline-size: 100%; min-block-size: 1.5rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n    ></div>\n  {/snippet}\n  <div\n    style=\"inline-size: 100%; min-block-size: 7rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n  {#snippet footer()}\n    <div\n      style=\"inline-size: 100%; min-block-size: 1.5rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n    ></div>\n  {/snippet}\n</Card>\n"
    },
    {
      "id": "with-header",
      "title": "Card with header",
      "description": "A card with a separated header region above the body.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n</script>\n\n<Card>\n  {#snippet header()}\n    <div\n      style=\"min-block-size: 1.5rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n    ></div>\n  {/snippet}\n  <div\n    style=\"min-block-size: 7rem; border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-sm); background: repeating-linear-gradient(-45deg, transparent, transparent 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5rem, color-mix(in oklch, var(--cinder-border-muted), transparent 70%) 0.5625rem);\"\n  ></div>\n</Card>\n"
    }
  ]
}
