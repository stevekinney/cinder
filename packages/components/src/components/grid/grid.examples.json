{
  "$schema": "../../schemas/examples.schema.json",
  "component": "grid",
  "import": "@lostgradient/cinder/grid",
  "examples": [
    {
      "id": "auto-fill",
      "title": "Auto-fill cards",
      "description": "Grid can create intrinsic responsive columns from a minimum item width.",
      "code": "<script lang=\"ts\">\n  import { Card } from '@lostgradient/cinder/card';\n  import { Grid } from '@lostgradient/cinder/grid';\n</script>\n\n<Grid minItemWidth=\"14rem\" gap=\"var(--cinder-space-4)\">\n  <Card>Analytics</Card>\n  <Card>Integrations</Card>\n  <Card>Billing</Card>\n  <Card>Audit log</Card>\n</Grid>\n"
    },
    {
      "id": "basic",
      "title": "Explicit placement",
      "description": "A 12-column grid using Grid.Item for spans while plain children use auto-placement.",
      "code": "<script lang=\"ts\">\n  import { Grid } from '@lostgradient/cinder/grid';\n</script>\n\n<Grid columns={12} gap=\"var(--cinder-space-4)\" aria-label=\"Profile form layout\">\n  <Grid.Item span={6}>\n    <div style=\"padding: 1rem; border: 1px solid var(--cinder-border-muted);\">First name</div>\n  </Grid.Item>\n  <Grid.Item span={6}>\n    <div style=\"padding: 1rem; border: 1px solid var(--cinder-border-muted);\">Last name</div>\n  </Grid.Item>\n  <Grid.Item span={12}>\n    <div style=\"padding: 1rem; border: 1px solid var(--cinder-border-muted);\">Email address</div>\n  </Grid.Item>\n</Grid>\n"
    },
    {
      "id": "feature-grid",
      "title": "Feature grid",
      "description": "A product-features section recipe: Grid with minItemWidth lays out icon + title + description tiles under a section heading.",
      "code": "<script lang=\"ts\">\n  import { Container } from '@lostgradient/cinder/container';\n  import { Grid } from '@lostgradient/cinder/grid';\n  import Accessibility from 'lucide-svelte/icons/accessibility';\n  import Palette from 'lucide-svelte/icons/palette';\n  import Zap from 'lucide-svelte/icons/zap';\n\n  const items = [\n    {\n      icon: Zap,\n      title: 'Fast setup',\n      description: 'Install, import styles, and start composing in minutes.',\n    },\n    {\n      icon: Accessibility,\n      title: 'Accessible by default',\n      description: 'Keyboard interaction and semantic markup are built in.',\n    },\n    {\n      icon: Palette,\n      title: 'Theme-ready tokens',\n      description: 'Adapt spacing, type, and color with CSS custom properties.',\n    },\n  ];\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div style=\"display: grid; gap: var(--cinder-space-6);\">\n      <header style=\"display: grid; gap: var(--cinder-space-3); max-inline-size: 70ch;\">\n        <h2\n          style=\"margin: 0; font-size: var(--cinder-text-3xl); line-height: var(--cinder-leading-tight);\"\n        >\n          Everything your product team needs\n        </h2>\n        <p style=\"margin: 0; color: var(--cinder-text-muted);\">\n          Ship UI that looks polished from day one, without rebuilding foundational components.\n        </p>\n      </header>\n\n      <Grid\n        as=\"ul\"\n        minItemWidth=\"14rem\"\n        gap=\"var(--cinder-space-4)\"\n        style=\"list-style: none; margin: 0; padding: 0;\"\n      >\n        {#each items as item (item.title)}\n          {@const Icon = item.icon}\n          <li\n            style=\"border: 1px solid var(--cinder-border); border-radius: var(--cinder-radius-lg); padding: var(--cinder-space-4); background: var(--cinder-surface-raised); display: grid; gap: var(--cinder-space-2);\"\n          >\n            <span aria-hidden=\"true\" style=\"color: var(--cinder-accent-text); line-height: 1;\">\n              <Icon size={20} />\n            </span>\n            <h3 style=\"margin: 0; font-size: var(--cinder-text-base);\">{item.title}</h3>\n            <p\n              style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\"\n            >\n              {item.description}\n            </p>\n          </li>\n        {/each}\n      </Grid>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "logo-cloud",
      "title": "Logo cloud",
      "description": "A trusted-by strip recipe: Grid auto-fills brand wordmarks under a heading, muted onto the subtle text ramp. Swap the wordmark spans for your real logo images.",
      "code": "<script lang=\"ts\">\n  import { Container } from '@lostgradient/cinder/container';\n  import { Grid } from '@lostgradient/cinder/grid';\n\n  const logos = [\n    { name: 'Acme', href: '#' },\n    { name: 'Orbit', href: '#' },\n    { name: 'Northline' },\n    { name: 'Wave', href: '#' },\n    { name: 'Summit' },\n  ];\n\n  // Placeholder wordmarks stand in for logo images; a real app renders\n  // <img> marks here (typically with `filter: grayscale(1)` to mute them).\n  const wordmarkStyle =\n    'font-size: var(--cinder-text-xl); font-weight: var(--cinder-font-semibold); letter-spacing: -0.02em; color: var(--cinder-text-subtle);';\n</script>\n\n<section style=\"padding-block: var(--cinder-space-8);\">\n  <Container maxWidth=\"wide\">\n    <div style=\"display: grid; gap: var(--cinder-space-5);\">\n      <header style=\"display: grid; gap: var(--cinder-space-2);\">\n        <h2 style=\"margin: 0;\">Trusted by modern product teams</h2>\n      </header>\n\n      <Grid\n        as=\"ul\"\n        minItemWidth=\"8rem\"\n        gap=\"var(--cinder-space-5)\"\n        style=\"list-style: none; margin: 0; padding: 0; align-items: center;\"\n      >\n        {#each logos as logo (logo.name)}\n          <li style=\"display: flex; justify-content: center;\">\n            {#if logo.href}\n              <a\n                href={logo.href}\n                style=\"display: inline-flex; text-decoration: none; {wordmarkStyle}\"\n              >\n                {logo.name}\n              </a>\n            {:else}\n              <span style={wordmarkStyle}>{logo.name}</span>\n            {/if}\n          </li>\n        {/each}\n      </Grid>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "narrow-collapse",
      "title": "Narrow collapse",
      "description": "With narrowCollapseEnabled, Grid falls back to a single column and resets item placement once its own width is 48rem or less.",
      "code": "<script lang=\"ts\">\n  import { Grid } from '@lostgradient/cinder/grid';\n</script>\n\n<Grid\n  columns={3}\n  gap=\"var(--cinder-space-4)\"\n  narrowCollapseEnabled\n  aria-label=\"Narrow collapse demo\"\n>\n  <div style=\"padding: 1rem; border: 1px solid var(--cinder-border-muted);\">One</div>\n  <div style=\"padding: 1rem; border: 1px solid var(--cinder-border-muted);\">Two</div>\n  <div style=\"padding: 1rem; border: 1px solid var(--cinder-border-muted);\">Three</div>\n</Grid>\n"
    }
  ]
}
