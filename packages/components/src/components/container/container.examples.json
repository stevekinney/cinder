{
  "$schema": "../../schemas/examples.schema.json",
  "component": "container",
  "import": "@lostgradient/cinder/container",
  "examples": [
    {
      "id": "basic",
      "title": "Prose reading column",
      "description": "The prose width caps line length at a readable measure and centers the column.",
      "code": "<script lang=\"ts\">\n  import { Container } from '@lostgradient/cinder/container';\n</script>\n\n<Container maxWidth=\"prose\">\n  <h1 style=\"font: var(--cinder-font-heading-lg); color: var(--cinder-text);\">Reading column</h1>\n  <p style=\"font: var(--cinder-font-body-md); color: var(--cinder-text-muted);\">\n    Container keeps long-form content at a comfortable measure and adds an inline gutter so text\n    never touches the viewport edge.\n  </p>\n</Container>\n"
    },
    {
      "id": "call-to-action",
      "title": "Call to action",
      "description": "A conversion band recipe: Container wraps an accent-tinted panel with a short headline, supporting copy, and primary/secondary action buttons.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder/button';\n  import { Container } from '@lostgradient/cinder/container';\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div\n      style=\"border: 1px solid color-mix(in oklch, var(--cinder-accent), transparent 65%); border-radius: var(--cinder-radius-lg); background: color-mix(in oklch, var(--cinder-accent), transparent 92%); padding: var(--cinder-space-7); display: grid; gap: var(--cinder-space-4); justify-items: center; text-align: center;\"\n    >\n      <h2\n        style=\"margin: 0; font-size: var(--cinder-text-3xl); line-height: var(--cinder-leading-tight);\"\n      >\n        Ready to level up your product UI?\n      </h2>\n      <p style=\"margin: 0; color: var(--cinder-text-muted); max-inline-size: 60ch;\">\n        Start with Cinder and ship accessible components with confidence.\n      </p>\n      <div style=\"display: flex; flex-wrap: wrap; gap: var(--cinder-space-3);\">\n        <Button label=\"Start free\" variant=\"primary\" />\n        <Button label=\"Talk to sales\" variant=\"secondary\" />\n      </div>\n      <p style=\"margin: 0; color: var(--cinder-text-subtle); font-size: var(--cinder-text-sm);\">\n        No credit card required.\n      </p>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "hero-section",
      "title": "Hero section",
      "description": "A landing-page hero recipe: Container centers an eyebrow, headline, supporting copy, and CTA row beside an AspectRatio media panel.",
      "code": "<script lang=\"ts\">\n  import { AspectRatio } from '@lostgradient/cinder/aspect-ratio';\n  import { Button } from '@lostgradient/cinder/button';\n  import { Container } from '@lostgradient/cinder/container';\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div\n      style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: var(--cinder-space-8); align-items: center;\"\n    >\n      <div\n        style=\"display: flex; flex-direction: column; gap: var(--cinder-space-4); align-items: flex-start;\"\n      >\n        <p\n          style=\"margin: 0; text-transform: uppercase; letter-spacing: 0.04em; color: var(--cinder-accent-text); font-size: var(--cinder-text-xs); font-weight: var(--cinder-font-semibold);\"\n        >\n          Now in public beta\n        </p>\n        <h2\n          style=\"margin: 0; font-size: clamp(var(--cinder-text-3xl), 4vw, var(--cinder-text-5xl)); line-height: var(--cinder-leading-tight); max-inline-size: 24ch;\"\n        >\n          Build polished product interfaces in days, not months.\n        </h2>\n        <p\n          style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-lg); max-inline-size: 60ch;\"\n        >\n          Cinder gives your team accessible UI foundations and high-level patterns so you can focus\n          on shipping user value.\n        </p>\n        <div style=\"display: flex; flex-wrap: wrap; gap: var(--cinder-space-3);\">\n          <Button label=\"Start free trial\" variant=\"primary\" />\n          <Button label=\"View docs\" variant=\"secondary\" />\n        </div>\n        <p style=\"margin: 0; color: var(--cinder-text-subtle); font-size: var(--cinder-text-sm);\">\n          Trusted by 2,000+ product teams worldwide.\n        </p>\n      </div>\n      <div style=\"min-inline-size: 0;\">\n        <AspectRatio ratio=\"16/9\">\n          <!-- Placeholder media panel — a real app renders its product\n               screenshot or video <img> here with the same geometry. -->\n          <div\n            role=\"img\"\n            aria-label=\"Product dashboard preview\"\n            style=\"inline-size: 100%; block-size: 100%; background: var(--cinder-surface-inset); border: 1px solid var(--cinder-border-muted); border-radius: var(--cinder-radius-md);\"\n          ></div>\n        </AspectRatio>\n      </div>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "widths",
      "title": "Named width scale",
      "description": "narrow, wide, and full bracket the default content width for different layouts.",
      "code": "<script lang=\"ts\">\n  import { Container } from '@lostgradient/cinder/container';\n\n  const widths = ['narrow', 'wide', 'full'] as const;\n</script>\n\n<div style=\"display: grid; gap: var(--cinder-space-4);\">\n  {#each widths as width (width)}\n    <Container maxWidth={width}>\n      <div\n        style=\"padding: var(--cinder-space-4); border: 1px dashed var(--cinder-border-muted); border-radius: var(--cinder-radius-md); color: var(--cinder-text); font: var(--cinder-font-label-md);\"\n      >\n        maxWidth=\"{width}\"\n      </div>\n    </Container>\n  {/each}\n</div>\n"
    }
  ]
}
