{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": ["id", "reason"],
  "metadata": {
    "unsupportedProps": [
      {
        "name": "class",
        "reason": "unknown-shape"
      }
    ]
  }
}
