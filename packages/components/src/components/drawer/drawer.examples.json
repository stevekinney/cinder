{
  "$schema": "../../schemas/examples.schema.json",
  "component": "drawer",
  "import": "@lostgradient/cinder/drawer",
  "examples": [
    {
      "id": "basic",
      "title": "Basic drawer",
      "description": "An edge-anchored slide-in panel with controls for placement, size, and triggerRef.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder/button';\n  import { Checkbox } from '@lostgradient/cinder/checkbox';\n  import { Drawer } from '@lostgradient/cinder/drawer';\n  import type { DrawerPlacement, DrawerSize } from '@lostgradient/cinder/drawer';\n  import { Select } from '@lostgradient/cinder/select';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n  let placement = $state<DrawerPlacement>('right');\n  let size = $state<DrawerSize>('md');\n  let useTriggerRef = $state(true);\n\n  const placementOptions: { value: DrawerPlacement; label: string }[] = [\n    { value: 'right', label: 'right' },\n    { value: 'left', label: 'left' },\n    { value: 'bottom', label: 'bottom' },\n  ];\n  const sizeOptions: { value: DrawerSize; label: string }[] = [\n    { value: 'sm', label: 'sm' },\n    { value: 'md', label: 'md' },\n    { value: 'lg', label: 'lg' },\n    { value: 'xl', label: 'xl' },\n  ];\n</script>\n\n<div style=\"display: flex; flex-direction: column; gap: 1rem; max-width: 32rem;\">\n  <div style=\"display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;\">\n    <Select\n      id=\"placement\"\n      bind:value={placement}\n      options={placementOptions}\n      label=\"Placement\"\n    />\n    <Select id=\"size\" bind:value={size} options={sizeOptions} label=\"Size\" />\n    <Checkbox id=\"use-trigger-ref\" bind:checked={useTriggerRef} label=\"Use triggerRef\" />\n  </div>\n\n  <Button\n    label=\"Open drawer\"\n    onclick={(event) => {\n      triggerRef = useTriggerRef ? event.currentTarget : null;\n      open = true;\n    }}\n  />\n</div>\n\n<Drawer\n  bind:open\n  {placement}\n  {size}\n  title=\"Drawer panel\"\n  triggerRef={useTriggerRef ? triggerRef : null}\n>\n  <p>This is the drawer body. You can put any content here.</p>\n  <p>Current settings: placement={placement}, size={size}.</p>\n\n  {#snippet footer()}\n    <div style=\"display: flex; gap: 0.5rem;\">\n      <Button variant=\"secondary\" label=\"Cancel\" onclick={() => (open = false)} />\n      <Button label=\"Confirm\" onclick={() => (open = false)} />\n    </div>\n  {/snippet}\n</Drawer>\n"
    },
    {
      "id": "bottom-sheet",
      "title": "Bottom sheet",
      "description": "A bottom-placed drawer with a drag handle and enough content to scroll.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder/button';\n  import { Drawer } from '@lostgradient/cinder/drawer';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n\n  const actions = Array.from({ length: 14 }, (_, index) => ({\n    id: `action-${index + 1}`,\n    label: `Workspace action ${index + 1}`,\n    description: 'Secondary action detail and short explanatory copy.',\n  }));\n</script>\n\n<Button\n  label=\"Open bottom sheet\"\n  onclick={(event) => {\n    triggerRef = event.currentTarget as HTMLElement;\n    open = true;\n  }}\n/>\n\n<Drawer bind:open placement=\"bottom\" title=\"Workspace actions\" {triggerRef} dragHandleVisible>\n  <div style=\"display: grid; gap: 0.875rem;\">\n    {#each actions as action (action.id)}\n      <section>\n        <h3 style=\"margin: 0 0 0.25rem; font-size: var(--cinder-text-base);\">\n          {action.label}\n        </h3>\n        <p style=\"margin: 0; color: var(--cinder-text-muted);\">{action.description}</p>\n      </section>\n    {/each}\n  </div>\n\n  {#snippet footer()}\n    <Button label=\"Done\" onclick={() => (open = false)} />\n  {/snippet}\n</Drawer>\n"
    },
    {
      "id": "overflowing",
      "title": "Overflowing drawer",
      "description": "A side drawer with a scrollable body.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder/button';\n  import { Checkbox } from '@lostgradient/cinder/checkbox';\n  import { Drawer } from '@lostgradient/cinder/drawer';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n\n  // Prefix IDs with an example namespace so they don't collide if multiple\n  // examples are mounted on the same page.\n  const filters = Array.from({ length: 30 }, (_, index) => ({\n    id: `drawer-overflowing-filter-${index + 1}`,\n    label: `Filter group ${index + 1}`,\n  }));\n</script>\n\n<Button\n  label=\"Open drawer\"\n  onclick={(event) => {\n    triggerRef = event.currentTarget as HTMLElement;\n    open = true;\n  }}\n/>\n\n<Drawer bind:open title=\"Filters\" {triggerRef}>\n  <div style=\"display: grid; gap: 0.75rem;\">\n    {#each filters as filter (filter.id)}\n      <Checkbox id={filter.id} label={filter.label} />\n    {/each}\n  </div>\n\n  {#snippet footer()}\n    <Button variant=\"secondary\" label=\"Cancel\" onclick={() => (open = false)} />\n    <Button label=\"Apply\" onclick={() => (open = false)} />\n  {/snippet}\n</Drawer>\n"
    }
  ]
}
