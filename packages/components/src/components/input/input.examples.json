{
  "$schema": "../../schemas/examples.schema.json",
  "component": "input",
  "import": "@lostgradient/cinder/input",
  "examples": [
    {
      "id": "basic",
      "title": "Basic input",
      "description": "Text input with label and bound value.",
      "code": "<script lang=\"ts\">\n  import { Input } from '@lostgradient/cinder/input';\n\n  let name = $state('');\n</script>\n\n<Input id=\"field\" bind:value={name} label=\"Full name\" placeholder=\"Jane Smith\" />\n{#if name}\n  <p style=\"margin-top: 0.5rem; color: var(--cinder-text-muted);\">Hello, {name}!</p>\n{/if}\n"
    },
    {
      "id": "code-variant",
      "title": "Code variant",
      "description": "variant=\"code\" applies a shared monospace metric set for source-like values such as regular expressions, URIs, or identifiers.",
      "code": "<script lang=\"ts\">\n  import { Input } from '@lostgradient/cinder/input';\n\n  let pattern = $state('^[a-z0-9-]+$');\n</script>\n\n<Input id=\"field\" bind:value={pattern} label=\"Pattern (regex)\" variant=\"code\" />\n"
    },
    {
      "id": "compact-hidden-label",
      "title": "Compact field with hidden label",
      "description": "Keep the accessible name from label while visually hiding it for compact auth/token layouts.",
      "code": "<script lang=\"ts\">\n  import { Input } from '@lostgradient/cinder/input';\n\n  let token = $state('');\n</script>\n\n<Input\n  id=\"demo-token\"\n  bind:value={token}\n  label=\"Demo token\"\n  labelVisible={false}\n  autocomplete=\"off\"\n  placeholder=\"Enter demo token\"\n/>\n"
    },
    {
      "id": "newsletter-signup",
      "title": "Newsletter signup",
      "description": "An email-capture section recipe: a form pairs Input with a submit Button inside a raised panel, with heading copy and a consent line.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder/button';\n  import { Container } from '@lostgradient/cinder/container';\n  import { Input } from '@lostgradient/cinder/input';\n\n  let email = $state('');\n\n  function handleSubmit(event: SubmitEvent): void {\n    event.preventDefault();\n    // eslint-disable-next-line no-console\n    console.log('newsletter signup', email.trim());\n  }\n</script>\n\n<section style=\"padding-block: var(--cinder-space-10);\">\n  <Container maxWidth=\"wide\">\n    <div\n      style=\"border: 1px solid var(--cinder-border); background: var(--cinder-surface-raised); border-radius: var(--cinder-radius-lg); padding: var(--cinder-space-6); display: grid; gap: var(--cinder-space-4);\"\n    >\n      <header style=\"display: grid; gap: var(--cinder-space-2);\">\n        <h2 style=\"margin: 0;\">Stay ahead with monthly product insights</h2>\n        <p style=\"margin: 0; color: var(--cinder-text-muted);\">\n          Get shipping tips, release notes, and real-world examples from the Cinder team.\n        </p>\n      </header>\n\n      <form\n        style=\"display: flex; flex-wrap: wrap; gap: var(--cinder-space-3); align-items: flex-end;\"\n        onsubmit={handleSubmit}\n      >\n        <div style=\"flex: 1 1 16rem; min-inline-size: 0;\">\n          <Input id=\"newsletter-email\" type=\"email\" label=\"Email address\" bind:value={email} required />\n        </div>\n        <Button type=\"submit\" label=\"Subscribe\" variant=\"primary\" />\n      </form>\n\n      <p style=\"margin: 0; color: var(--cinder-text-muted);\">\n        No spam. One email per month. Unsubscribe anytime.\n      </p>\n      <p style=\"margin: 0; font-size: var(--cinder-text-sm); color: var(--cinder-text-subtle);\">\n        We respect your inbox and your privacy.\n      </p>\n    </div>\n  </Container>\n</section>\n"
    },
    {
      "id": "sign-in",
      "title": "Sign-in composition",
      "description": "Composition of FormField + Input + Button with a top-of-form Alert auth-error region. Demonstrates the required autocomplete values and the assertive announcement pattern via role=\"alert\".",
      "code": "<script lang=\"ts\">\n  import { Alert } from '@lostgradient/cinder/alert';\n  import { Button } from '@lostgradient/cinder/button';\n  import { FormField } from '@lostgradient/cinder/form-field';\n  import { Input } from '@lostgradient/cinder/input';\n  let email = $state('');\n  let password = $state('');\n  let authError = $state<string | undefined>(undefined);\n  let submitting = $state(false);\n\n  function handleSignIn() {\n    if (submitting) return;\n    // Clear any prior error so a re-submit re-announces by re-mounting the Alert\n    // rather than mutating its text (assistive tech announces on mount of role=\"alert\").\n    authError = undefined;\n    submitting = true;\n\n    // Static example: simulate an auth failure. A real implementation would\n    // POST { email, password } and redirect on success.\n    setTimeout(() => {\n      authError = 'Email or password is incorrect.';\n      submitting = false;\n    }, 600);\n  }\n</script>\n\n<form\n  novalidate\n  aria-labelledby=\"sign-in-heading\"\n  style=\"display: flex; flex-direction: column; gap: 1rem;\"\n  onsubmit={(event) => {\n    event.preventDefault();\n    handleSignIn();\n  }}\n>\n  <h2 id=\"sign-in-heading\">Sign in</h2>\n\n  <!--\n    Top-of-form auth-error region.\n    Alert's role=\"alert\" implies aria-live=\"assertive\" and aria-atomic=\"true\".\n    We intentionally do NOT add an explicit aria-live attribute (see alert.test.ts:\n    \"has role=alert on root element and does not set an explicit aria-live\").\n    Mounting the Alert in response to submit triggers the assertive announcement.\n  -->\n  {#if authError}\n    <Alert variant=\"danger\">\n      {authError}\n    </Alert>\n  {/if}\n\n  <FormField id=\"sign-in-email\" label=\"Email\" required>\n    <!-- autocomplete=\"email\" — the identifier is an email address.\n         Use \"username\" instead when the field collects an opaque handle. -->\n    <Input\n      id=\"sign-in-email\"\n      type=\"email\"\n      bind:value={email}\n      autocomplete=\"email\"\n      required\n      placeholder=\"you@example.com\"\n    />\n  </FormField>\n\n  <FormField id=\"sign-in-password\" label=\"Password\" required>\n    <!-- autocomplete=\"current-password\" — required for password managers to\n         recognize this as a sign-in form and offer saved credentials. -->\n    <Input\n      id=\"sign-in-password\"\n      type=\"password\"\n      bind:value={password}\n      autocomplete=\"current-password\"\n      required\n    />\n  </FormField>\n\n  <Button type=\"submit\" variant=\"primary\" loading={submitting}>\n    {submitting ? 'Signing in…' : 'Sign in'}\n  </Button>\n</form>\n"
    },
    {
      "id": "types",
      "title": "Input types",
      "description": "Text, email, password, search, date, tel, and url types.",
      "code": "<script lang=\"ts\">\n  import { Input } from '@lostgradient/cinder/input';\n  let text = $state('');\n  let email = $state('');\n  let password = $state('');\n  let search = $state('');\n  let date = $state('');\n</script>\n\n<div style=\"display: flex; flex-direction: column; gap: 1rem;\">\n  <Input id=\"t-text\" type=\"text\" bind:value={text} label=\"Text\" placeholder=\"Plain text\" />\n  <Input id=\"t-email\" type=\"email\" bind:value={email} label=\"Email\" placeholder=\"you@example.com\" />\n  <Input id=\"t-password\" type=\"password\" bind:value={password} label=\"Password\" />\n  <Input id=\"t-search\" type=\"search\" bind:value={search} label=\"Search\" placeholder=\"Search…\" />\n  <Input id=\"t-date\" type=\"date\" bind:value={date} label=\"Date\" />\n</div>\n"
    },
    {
      "id": "with-error",
      "title": "Input with error",
      "description": "Error message wired via aria-invalid and aria-describedby.",
      "code": "<script lang=\"ts\">\n  import { Input } from '@lostgradient/cinder/input';\n  let email = $state('not-an-email');\n  const hasError = $derived(!email.includes('@'));\n</script>\n\n<Input\n  id=\"email\"\n  type=\"email\"\n  bind:value={email}\n  label=\"Email address\"\n  description=\"We'll never share your email.\"\n  {...hasError ? { error: 'Enter a valid email address.' } : {}}\n/>\n"
    }
  ]
}
