{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "Status and role color triples (background/foreground/border) for soft tinted surfaces, plus muted/subtle derivatives. Used by components like Alert and Toast that need a soft tinted surface with semantically-paired text and border colors; the solid `accent`/`danger`/`info`/`success`/`warning` tokens remain for accent fills such as solid badges.",
    "accent": {
      "background": {
        "$value": { "colorSpace": "oklch", "components": [0.93472, 0.02816, 256.8] },
        "$description": "Soft accent-tinted background, mixed 88% toward the current surface.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-color-accent-bg",
            "public": true,
            "category": "color",
            "cssRecipe": "color-mix(in oklch, var(--cinder-accent), var(--cinder-surface) 88%)"
          }
        }
      },
      "foreground": {
        "$value": "{accent.text}",
        "$description": "Foreground color on the soft accent surface.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-color-accent-fg",
            "public": true,
            "category": "color",
            "cssRecipe": null
          }
        }
      },
      "border": {
        "$value": { "colorSpace": "oklch", "components": [0.5, 0.22, 270], "alpha": 0.4 },
        "$description": "Soft accent-tinted border, the accent color mixed 60% toward transparent.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-color-accent-border",
            "public": true,
            "category": "color",
            "cssRecipe": "color-mix(in oklch, var(--cinder-accent), transparent 60%)"
          }
        }
      }
    },
    "checker": {
      "base": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
        "$description": "Transparency checkerboard base tile, shared by color-domain components. Light mode preserves the historical white/gray grid; dark mode keeps the pattern visible without flashing a white backing inside dark chrome.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-color-checker-base",
            "public": true,
            "category": "color",
            "cssRecipe": "light-dark(#fff, oklch(28% 0.02 245))"
          }
        }
      },
      "tile": {
        "$value": { "colorSpace": "srgb", "components": [0.8, 0.8, 0.8], "hex": "#cccccc" },
        "$description": "Transparency checkerboard alternate tile.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-color-checker-tile",
            "public": true,
            "category": "color",
            "cssRecipe": "light-dark(#ccc, oklch(38% 0.02 245))"
          }
        }
      }
    },
    "danger": {
