        "$value": { "colorSpace": "oklch", "components": [0.67784, 0.05, 338.2] },
        "$description": "Danger color moved toward the current surface. Derived in one polarity-aware recipe shared by all four status colors.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-color-danger-muted",
            "public": true,
            "category": "color",
            "cssRecipe": "oklch( from color-mix(in oklch, var(--cinder-danger), var(--cinder-surface) 36%) l min(c, 0.05) h )"
