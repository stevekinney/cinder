        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "Extra-small control height (24px).",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-control-height-xs",
            "public": true,
            "category": "size",
            "cssRecipe": null
          }
        }
      },
      "sm": {
        "$value": {
          "value": 2,
          "unit": "rem"
        },
        "$description": "Small control height; the toolbar default (32px).",
