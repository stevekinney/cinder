  "radius": {
    "$type": "dimension",
    "$description": "6 / 8 / 12px corner radii. A previous pass stepped the whole scale down to 4/6/8 on the theory that rounding compounds when controls nest \u2014 it does, but the fix for a bubbly nested corner is the concentric nesting rule, not shrinking every radius: at 4/6/8, large panels (code blocks, cards, dialogs) read as hard-cornered plates, since a radius proportionate on a 28px button is nearly invisible on a 600px panel. An inner element inset by N inside a rounded container is concentric only at `outer - N`; express the inner radius as `calc(var(--cinder-radius-<outer>) - <inset>)` so it tracks the outer token instead of drifting.",
    "small": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      },
      "$description": "Compact control corner radius (6px).",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-radius-sm",
          "public": true,
          "category": "radius",
          "cssRecipe": null
        }
      }
    },
    "medium": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      },
      "$description": "Default control corner radius.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-radius-md",
          "public": true,
          "category": "radius",
          "cssRecipe": null
        }
      }
    },
    "large": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      },
      "$description": "Surface-level corner radius for cards, dialogs, and other large panels (12px).",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-radius-lg",
          "public": true,
          "category": "radius",
          "cssRecipe": null
        }
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      },
      "$description": "Fully rounded corner radius for pills and circular controls.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-radius-full",
          "public": true,
          "category": "radius",
          "cssRecipe": null
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation shadows. Each color argument is wrapped in `light-dark()` individually so dark mode paints a light-neutral elevation instead of invisible black-on-dark; within any one token the offsets, blur radii, and spread radii are identical across the light and dark arms, only the color/alpha branches differ per theme.",
    "small": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.1
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.06
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 1,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Hairline elevation for barely-raised surfaces. Gained a second hairline layer and higher alphas in this refinement pass (light 0.08 -> 0.1 plus a new 0.06 layer; dark 0.06 -> 0.09 plus a new 0.05 layer) for deeper, crisper elevation. Light and dark themes carry distinct explicit values (see the theme modifier documents) alongside this `light-dark()` recipe.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-shadow-sm",
          "public": true,
          "category": "shadow",
          "cssRecipe": "0 1px 2px light-dark(oklch(0% 0 0 / 0.1), oklch(100% 0 0 / 0.09)), 0 1px 1px light-dark(oklch(0% 0 0 / 0.06), oklch(100% 0 0 / 0.05))"
        }
      }
    },
    "medium": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.12
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 6,
            "unit": "px"
          },
          "spread": {
            "value": -1,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.1
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": -2,
            "unit": "px"
          }
        }
      ],
      "$description": "Mid elevation for raised surfaces such as popovers.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-shadow-md",
          "public": true,
          "category": "shadow",
          "cssRecipe": "0 4px 6px -1px light-dark(oklch(0% 0 0 / 0.12), oklch(100% 0 0 / 0.09)), 0 2px 4px -2px light-dark(oklch(0% 0 0 / 0.1), oklch(100% 0 0 / 0.06))"
        }
      }
    },
    "large": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.14
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 15,
            "unit": "px"
          },
          "spread": {
            "value": -3,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.12
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 6,
            "unit": "px"
          },
          "spread": {
            "value": -4,
            "unit": "px"
          }
        }
      ],
      "$description": "High elevation for dialogs and drawers.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-shadow-lg",
          "public": true,
          "category": "shadow",
          "cssRecipe": "0 10px 15px -3px light-dark(oklch(0% 0 0 / 0.14), oklch(100% 0 0 / 0.11)), 0 4px 6px -4px light-dark(oklch(0% 0 0 / 0.12), oklch(100% 0 0 / 0.07))"
        }
      }
    },
    "overlay": {
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.14
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 15,
            "unit": "px"
          },
          "spread": {
            "value": -3,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0.12
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 6,
            "unit": "px"
          },
          "spread": {
            "value": -4,
            "unit": "px"
          }
        }
      ],
      "$description": "Elevation for modal/drawer overlay panels. Dark mode uses a stronger black shadow rather than the light-neutral lift the other tiers use, since overlay panels sit above a dimmed backdrop rather than page content.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-shadow-overlay",
          "public": true,
          "category": "shadow",
          "cssRecipe": "0 10px 15px -3px light-dark(oklch(0% 0 0 / 0.14), oklch(0% 0 0 / 0.45)), 0 4px 6px -4px light-dark(oklch(0% 0 0 / 0.12), oklch(0% 0 0 / 0.32))"
        }
      }
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$description": "Shared height tier for any interactive control that needs to align with its siblings in a toolbar, button group, or form row. Adoption is opt-in per component; Buttons use their own tighter height ladder (see `button.height.*`).",
