  },
  "toggle": {
    "$type": "color",
    "$description": "Toggle-track tokens. Single-consumer (toggle.css); encode the dark-arm contrast improvement here so toggle.css uses only var() references and stays theme-guard clean.",
    "track": {
      "off-resting": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.85, 0.004, 255]
        },
        "$description": "Toggle track color in the off, resting state. Light arm preserves the `border.muted` look; dark arm raises lightness for >=3:1 shape contrast against the surface.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-toggle-track-off-resting",
            "public": true,
            "category": "color",
            "component": "toggle",
            "cssRecipe": "light-dark(var(--cinder-border-muted), oklch(45% 0.02 245))"
          }
        }
      },
      "off-hover-resting": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.63, 0.006, 255]
        },
        "$description": "Toggle track color in the off state on hover. Steps up from `off-resting` to be distinguishable.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-toggle-track-off-hover-resting",
            "public": true,
            "category": "color",
            "component": "toggle",
            "cssRecipe": "light-dark(var(--cinder-border), oklch(52% 0.02 245))"
          }
        }
      }
    }
  }
}
