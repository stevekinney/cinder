  "ring": {
    "$description": "Focus ring geometry and color.",
    "width": {
      "$type": "dimension",
      "$value": { "value": 2, "unit": "px" },
      "$description": "Focus ring stroke width. A floor, not a preference: WCAG 2.4.13 wants an indicator at least as large as a 2px-thick perimeter of the control.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-ring-width",
          "public": true,
          "category": "size",
          "cssRecipe": null
        }
      }
    },
    "offset": {
      "$type": "dimension",
      "$value": { "value": 2, "unit": "px" },
      "$description": "Focus ring offset from the control edge.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-ring-offset",
          "public": true,
          "category": "size",
          "cssRecipe": null
        }
      }
    },
    "offset-color": {
      "$type": "color",
      "$value": "{surface.raised}",
      "$description": "Focus ring offset band color. The ring is a two-stop box-shadow and box-shadow cannot paint a transparent gap, so the offset band has to be some real color. Pinned to `surface.raised` (the top of the ramp) so the band disappears into raised surfaces, where controls overwhelmingly live, and reads as a light halo on recessed tiers.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-ring-offset-color",
          "public": true,
          "category": "color",
          "cssRecipe": null
        }
      }
    },
    "color": {
      "$type": "color",
      "$value": { "colorSpace": "oklch", "components": [0.55, 0.16, 270] },
      "$description": "Focus ring color, relative to `accent` so a consumer override re-derives the ring hue. Light arm clamps L to 0.55 for 3.56:1 against the widened ramp's darkest surface; `h` tracks the accent hue.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-ring-color",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark( oklch(from var(--cinder-accent) 0.55 0.16 h), oklch(from var(--cinder-accent) 0.7 0.14 h) )"
        }
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": { "colorSpace": "oklch", "components": [0.15, 0.035, 245] },
      "$description": "Ring color tuned for use on solid accent/fill surfaces (FloatingAction primary variant). Light arm is a near-black that contrasts both the accent fill and the page background; dark arm is a near-white that contrasts the bright dark-mode accent and the dark page background.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-ring-on-accent",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(15% 0.035 245), oklch(100% 0 0))"
        }
      }
    }
  },
