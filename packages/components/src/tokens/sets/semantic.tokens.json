{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "background": {
    "$type": "color",
    "$value": { "colorSpace": "oklch", "components": [0.984, 0.003, 255] },
    "$description": "Page canvas background, distinct from `surface.base` (a card body). Sits on the surface ramp that runs inset -> bg -> surface -> raised. Light mode anchors that ramp at white (0.960 -> 0.984 -> 0.994 -> 1.000); dark mode runs the same ordering at low lightness.",
    "$extensions": {
      "com.lostgradient.cinder": {
        "cssProperty": "--cinder-bg",
        "public": true,
        "category": "color",
        "cssRecipe": "light-dark(oklch(98.4% 0.003 255), oklch(15% 0.035 245))"
      }
    }
  },
  "surface": {
    "$type": "color",
    "$description": "Cinder layers surfaces in three tiers, each with one job: `surface.raised` is the outer background of a card/container, `surface.base` is a card body (primary content area), and `surface.inset` is a sunken region inside a card body. A card root sets one background; nested regions inherit it unless the component deliberately changes tiers. Light mode anchors at white: the ramp is `inset 0.960 -> bg 0.984 -> surface 0.994 -> raised 1.000`, with elevation carried by border + shadow rather than fill separation. Dark mode builds up from near-black across a wider span. Hover/pressed derivatives mix toward the accent in light mode (proportional lightness mixes have no room left once the ramp is anchored at white) and toward white in dark mode (which still has headroom).",
    "base": {
      "$value": { "colorSpace": "oklch", "components": [0.994, 0.002, 255] },
      "$description": "Default semantic surface. Theme modifiers provide its dark value.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-surface",
          "public": true,
          "category": "color",
          "contrastPairs": ["text"],
          "cssRecipe": "light-dark(oklch(99.4% 0.002 255), oklch(21% 0.04 245))"
        }
      }
    },
    "raised": {
      "$root": {
        "$value": { "colorSpace": "oklch", "components": [1, 0, 255] },
        "$description": "Elevated semantic surface. Theme modifiers provide its dark value.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-surface-raised",
            "public": true,
            "category": "color",
            "contrastPairs": ["text"],
            "cssRecipe": "light-dark(oklch(100% 0 255), oklch(28% 0.045 245))"
          }
        }
      },
      "hover": {
        "$value": { "colorSpace": "oklch", "components": [0.97, 0.0132, 255.9] },
        "$description": "Hover state of the raised surface. Light mode washes toward the accent; dark mode mixes toward white.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-surface-raised-hover",
            "public": true,
            "category": "color",
            "cssRecipe": "light-dark( color-mix(in oklch, var(--cinder-surface-raised), var(--cinder-accent) 6%), color-mix(in oklch, var(--cinder-surface-raised), oklch(100% 0 0) 2.5%) )"
          }
        }
      },
      "pressed": {
        "$value": { "colorSpace": "oklch", "components": [0.94, 0.0264, 256.8] },
        "$description": "Pressed state of the raised surface. Light mode washes toward the accent; dark mode mixes toward white.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-surface-raised-pressed",
            "public": true,
            "category": "color",
            "cssRecipe": "light-dark( color-mix(in oklch, var(--cinder-surface-raised), var(--cinder-accent) 12%), color-mix(in oklch, var(--cinder-surface-raised), oklch(100% 0 0) 6%) )"
          }
        }
      }
    },
    "inset": {
      "$value": { "colorSpace": "oklch", "components": [0.96, 0.005, 255] },
      "$description": "Sunken region inside a card body (code blocks, wells, recessed sub-regions).",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-surface-inset",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(96% 0.005 255), oklch(11% 0.03 245))"
        }
      }
    },
    "hover": {
      "$value": { "colorSpace": "oklch", "components": [0.96436, 0.01508, 255.9] },
      "$description": "Hover state of the default surface. Light mode washes toward the accent rather than darkening toward black: once the light ramp is anchored at white, its four resting tiers occupy only 0.040 lightness points, so a proportional lightness-only mix would be wider than the whole ramp it has to stay clear of. A light-mode hover that washes toward the brand accent separates by chroma and hue as well, staying legible at a lightness step small enough to fit the ramp.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-surface-hover",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark( color-mix(in oklch, var(--cinder-surface), var(--cinder-accent) 6%), color-mix(in oklch, var(--cinder-surface), oklch(100% 0 0) 2.5%) )"
        }
      }
    },
    "pressed": {
      "$value": { "colorSpace": "oklch", "components": [0.93472, 0.02816, 256.8] },
      "$description": "Pressed state of the default surface. Same accent-wash rationale as `surface.hover`, at a stronger mix percentage.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-surface-pressed",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark( color-mix(in oklch, var(--cinder-surface), var(--cinder-accent) 12%), color-mix(in oklch, var(--cinder-surface), oklch(100% 0 0) 6%) )"
        }
      }
    },
    "inverse": {
      "$value": { "colorSpace": "oklch", "components": [0.2, 0.018, 245] },
      "$description": "Inverse surface, used by Tooltip to stay a dark overlay in both themes. Light arm mirrors the text/surface swap (dark bg, light fg); dark arm uses the elevated surface + near-white text so the tooltip reads as a dark elevated layer rather than inverting to light.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-surface-inverse",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(var(--cinder-text), var(--cinder-surface-raised))"
        }
      }
    },
    "upcoming-marker": {
      "$value": { "colorSpace": "oklch", "components": [0.96, 0.005, 255] },
      "$description": "Upcoming step marker background. Keeps the inset treatment in light mode (surface-inset is visibly recessed vs surface), but lifts to surface in dark mode where surface-inset is nearly invisible against the dark stage.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-surface-upcoming-marker",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(var(--cinder-surface-inset), var(--cinder-surface))"
        }
      }
    }
  },
  "border": {
    "$type": "color",
    "control": {
      "$value": { "colorSpace": "oklch", "components": [0.63, 0.006, 255] },
      "$description": "Functional control boundary that clears 3:1 against supported surfaces. It is the border of the secondary Button, whose fill is `surface.raised` -- white in light mode, a raised dark surface in dark mode -- so in both themes it is the only thing making that control read as a control. In light mode it must not be lightened past ~0.85 or it stops clearing 3:1 against that near-white fill.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-border",
          "public": true,
          "category": "color",
          "contrastPairs": ["surface.base", "surface.raised"],
          "cssRecipe": "light-dark(oklch(63% 0.006 255), oklch(58% 0.05 245))"
        }
      }
    },
    "faint": {
      "$value": { "colorSpace": "oklch", "components": [0.92, 0.003, 255] },
      "$description": "Decorative-only hairline. Never use as a control boundary: it is intentionally below the WCAG 1.4.11 3:1 non-text threshold.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-border-faint",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(92% 0.003 255), oklch(33% 0.03 245))"
        }
      }
    },
    "muted": {
      "$value": { "colorSpace": "oklch", "components": [0.85, 0.004, 255] },
      "$description": "Decorative divider that wants less weight than `border.control`. Clears a separate 1.4:1 floor against its backdrop.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-border-muted",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(85% 0.004 255), oklch(38% 0.04 245))"
        }
      }
    },
    "strong": {
      "$value": { "colorSpace": "oklch", "components": [0.6, 0.008, 255] },
      "$description": "Stronger control boundary. Clears WCAG 1.4.11's 3:1 floor against every supported surface, like `border.control`.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-border-strong",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(60% 0.008 255), oklch(66% 0.06 245))"
        }
      }
    },
    "inverse": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 },
      "$description": "Border for surfaces using `surface.inverse` (Tooltip). Transparent in light mode; adds a 1px delineation in dark mode only.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-border-inverse",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(transparent, var(--cinder-border-strong))"
        }
      }
    }
  },
  "text": {
    "$type": "color",
    "$root": {
      "$value": { "colorSpace": "oklch", "components": [0.2, 0.018, 245] },
      "$description": "Default body text color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-text",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(20% 0.018 245), oklch(92% 0.02 245))"
        }
      }
    },
    "muted": {
      "$value": { "colorSpace": "oklch", "components": [0.32, 0.014, 245] },
      "$description": "Muted (secondary) text color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-text-muted",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(32% 0.014 245), oklch(82% 0.02 245))"
        }
      }
    },
    "subtle": {
      "$value": { "colorSpace": "oklch", "components": [0.42, 0.012, 245] },
      "$description": "Subtle (tertiary) text color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-text-subtle",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(42% 0.012 245), oklch(72% 0.02 245))"
        }
      }
    },
    "disabled": {
      "$value": { "colorSpace": "oklch", "components": [0.52, 0.01, 245] },
      "$description": "Disabled text color. Clears the 3:1 UI floor in both themes even though disabled controls are exempt from WCAG text contrast; a disabled control still has to be visible as a control.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-text-disabled",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(52% 0.01 245), oklch(64% 0.02 245))"
        }
      }
    },
    "inverse": {
      "$value": { "colorSpace": "oklch", "components": [0.994, 0.002, 255] },
      "$description": "Text color for use on `surface.inverse` (Tooltip).",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-text-inverse",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(var(--cinder-surface), var(--cinder-text))"
        }
      }
    }
  },
  "fill": {
    "$type": "color",
    "disabled": {
      "$value": { "colorSpace": "oklch", "components": [0.86, 0.006, 255] },
      "$description": "Neutral fill for disabled solid controls (disabled-checked checkbox/radio) so they stop misusing `text.disabled` (a text-lightness token) as an assertive fill. The glyph on top must use `text.disabled`, not `accent.contrast`: accent-contrast is dark ink in both arms and would be near-invisible on the dark-arm fill.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-fill-disabled",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(86% 0.006 255), oklch(30% 0.015 245))"
        }
      }
    }
  },
  "accent": {
    "$type": "color",
    "$description": "Brand accent - indigo (hue 270). Light arm is a deep indigo at L=0.50, dark enough that white clears WCAG AA on it (6.45:1), so the brand fill carries white labels in light mode. Dark arm is a bright periwinkle-indigo (chroma clamped to stay in sRGB gamut at L=0.72) that carries a dark-ink contrast label.",
    "$root": {
      "$value": { "colorSpace": "oklch", "components": [0.5, 0.22, 270] },
      "$description": "Brand accent fill color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-accent",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(50% 0.22 270), oklch(72% 0.14 270))"
        }
      }
    },
    "contrast": {
      "$value": { "colorSpace": "oklch", "components": [1, 0, 0] },
      "$description": "Label color for solid accent fills. Light arm flips to white (the indigo fill is dark enough); dark arm keeps dark ink against the bright dark-mode fill.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-accent-contrast",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(100% 0 0), oklch(15% 0.035 245))"
        }
      }
    },
    "hover": {
      "$value": { "colorSpace": "oklch", "components": [0.42, 0.22, 270] },
      "$description": "Hover step for solid accent fills, derived as a darker step of `accent` (l - 0.08, c and h held constant).",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-accent-hover",
          "public": true,
          "category": "color",
          "cssRecipe": "oklch(from var(--cinder-accent) calc(l - 0.08) c h)"
        }
      }
    },
    "active": {
      "$root": {
        "$value": { "colorSpace": "oklch", "components": [0.35, 0.22, 270] },
        "$description": "Active/pressed step for solid accent fills, derived as a darker step of `accent` (l - 0.15, c and h held constant).",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-accent-active",
            "public": true,
            "category": "color",
            "cssRecipe": "oklch(from var(--cinder-accent) calc(l - 0.15) c h)"
          }
        }
      },
      "on-fill": {
        "$value": { "colorSpace": "oklch", "components": [0.39, 0.22, 270] },
        "$description": "Pressed fill for solid accent surfaces that carry the `accent.contrast` label (primary Button, FloatingAction). Kept distinct from `accent.active` so label-bearing and non-label consumers can diverge if ever needed.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-accent-active-on-fill",
            "public": true,
            "category": "color",
            "cssRecipe": "oklch(from var(--cinder-accent) calc(l - 0.11) c h)"
          }
        }
      }
    },
    "text": {
      "$root": {
        "$value": { "colorSpace": "oklch", "components": [0.45, 0.22, 270] },
        "$description": "Accent used as text/icon on light surfaces. The light-mode fill accent (L=0.50) reads as a foreground at only ~4.7:1, just clearing AA, so this dedicated, slightly darker foreground token stays necessary for comfortable link/icon legibility. The dark arm matches the dark-mode accent fill.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-accent-text",
            "public": true,
            "category": "color",
            "cssRecipe": "light-dark(oklch(45% 0.22 270), oklch(72% 0.14 270))"
          }
        }
      },
      "hover": {
        "$value": { "colorSpace": "oklch", "components": [0.37, 0.22, 270] },
        "$description": "Hover step for text/icon links, derived as a darker step of `accent.text` (not the bright fill-derived `accent.hover`, which is lighter than the resting text color and drops below WCAG AA on near-white).",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-accent-text-hover",
            "public": true,
            "category": "color",
            "cssRecipe": "oklch(from var(--cinder-accent-text) calc(l - 0.08) c h)"
          }
        }
      }
    }
  },
  "danger": {
    "$type": "color",
    "$description": "Danger status color. Hover/active are authored explicitly rather than derived via relative-color: the relative-color form holds chroma constant while dropping lightness, but red (h 25) is near the sRGB gamut boundary, so a held chroma would silently clamp and desaturate at the light-arm hover/active lightnesses. Each light-arm state is pinned to its own in-gamut chroma maximum, keeping the darkening monotonic and in gamut.",
    "$root": {
      "$value": { "colorSpace": "oklch", "components": [0.5, 0.202, 25] },
      "$description": "Danger status fill color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-danger",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(50% 0.202 25), oklch(72% 0.172 25))"
        }
      }
    },
    "contrast": {
      "$value": { "colorSpace": "oklch", "components": [1, 0, 0] },
      "$description": "Label color for solid danger fills. Dark-mode danger is ~72% lightness; pure white fails WCAG AA on it, so the dark arm uses a near-black ink instead.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-danger-contrast",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(100% 0 0), oklch(12% 0.02 25))"
        }
      }
    },
    "hover": {
      "$value": { "colorSpace": "oklch", "components": [0.42, 0.171, 25] },
      "$description": "Hover step for solid danger fills, explicitly authored and fitted to the in-gamut chroma maximum at this lightness.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-danger-hover",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(42% 0.171 25), oklch(64% 0.172 25))"
        }
      }
    },
    "active": {
      "$value": { "colorSpace": "oklch", "components": [0.35, 0.142, 25] },
      "$description": "Active/pressed step for solid danger fills, explicitly authored and fitted to the in-gamut chroma maximum at this lightness.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-danger-active",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(35% 0.142 25), oklch(60% 0.172 25))"
        }
      }
    }
  },
  "info": {
    "$type": "color",
    "$description": "Info status color, hue 230. Nudged from hue 245 with the brand now indigo (h270): a 245 info sat only 25 degrees away and competed with it, while 230 reads as an unambiguous blue 40 degrees off the brand.",
    "$root": {
      "$value": { "colorSpace": "oklch", "components": [0.5, 0.098, 230] },
      "$description": "Info status fill color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-info",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(50% 0.098 230), oklch(78% 0.13 230))"
        }
      }
    },
    "contrast": {
      "$value": { "colorSpace": "oklch", "components": [1, 0, 0] },
      "$description": "Label color for solid info fills.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-info-contrast",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(100% 0 0), oklch(15% 0.03 230))"
        }
      }
    },
    "hover": {
      "$value": { "colorSpace": "oklch", "components": [0.42, 0.079, 230] },
      "$description": "Hover step for solid info fills.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-info-hover",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(42% 0.079 230), oklch(70% 0.13 230))"
        }
      }
    },
    "active": {
      "$value": { "colorSpace": "oklch", "components": [0.35, 0.065, 230] },
      "$description": "Active/pressed step for solid info fills.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-info-active",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(35% 0.065 230), oklch(62% 0.12 230))"
        }
      }
    }
  },
  "success": {
    "$type": "color",
    "$description": "Success status color, hue 145. Chroma fitted to the sRGB gamut so the browser renders the authored color instead of silently clamping it.",
    "$root": {
      "$value": { "colorSpace": "oklch", "components": [0.5, 0.157, 145] },
      "$description": "Success status fill color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-success",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(50% 0.157 145), oklch(78% 0.14 145))"
        }
      }
    },
    "contrast": {
      "$value": { "colorSpace": "oklch", "components": [1, 0, 0] },
      "$description": "Label color for solid success fills.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-success-contrast",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(100% 0 0), oklch(15% 0.03 145))"
        }
      }
    },
    "hover": {
      "$value": { "colorSpace": "oklch", "components": [0.42, 0.12, 145] },
      "$description": "Hover step for solid success fills.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-success-hover",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(42% 0.12 145), oklch(70% 0.14 145))"
        }
      }
    },
    "active": {
      "$value": { "colorSpace": "oklch", "components": [0.35, 0.1, 145] },
      "$description": "Active/pressed step for solid success fills.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-success-active",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(oklch(35% 0.1 145), oklch(62% 0.14 145))"
        }
      }
    }
  },
  "warning": {
    "$type": "color",
    "$description": "Warning status color, hue 75. Chroma fitted to the sRGB gamut (warning-light was over-saturated at 0.165 and rendered nearer 0.113 before fitting).",
    "$root": {
      "$value": { "colorSpace": "oklch", "components": [0.54, 0.113, 75] },
      "$description": "Warning status fill color.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-warning",
          "public": true,
